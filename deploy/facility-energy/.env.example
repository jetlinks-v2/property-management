# Copy to .env (ignored by Git); supply the environment's actual connection and trust values.
FACILITY_IMAGE=property-facility-energy:local
CLOUD_NETWORK=jetlinks-saas
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=property_facility_energy
DB_POOL_MAX_SIZE=16
DB_USERNAME=
DB_PASSWORD=
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0
RPC_TOKEN=
JWT_PUBLIC_KEY=
CLUSTER_SEEDS=cloud-runtime:18800
CLUSTER_EXTERNAL_HOST=facility-energy
RPC_EXTERNAL_HOST=facility-energy
# Optional while SMS is disabled; configure at least 32 characters before enabling SMS receipts.
FACILITY_SMS_RECEIPT_SECRET=
FACILITY_JOBS_ENABLED=true
API_UPSTREAM=http://cloud-gateway:8800
H5_PORT=9502
